{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "**/*.rs", "Cargo.toml", "package.json"],
      "outputs": [
        "dist/**",
        "*.node",
        "*.wasm",
        "index.js",
        "index.d.ts",
        "browser.js",
        "*.cjs",
        "*.mjs"
      ]
    },
    "build:wasm": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "**/*.rs", "Cargo.toml"],
      "outputs": [
        "*.wasm",
        "*.cjs",
        "*.cts",
        "*.mjs",
        "browser.js",
        // Named per addon: papyra.wasi-browser.js, papyra-office.wasi-browser.js.
        "*.wasi-browser.js"
      ]
    },
    // The office addon compiles crates outside its package — papyra-office, and
    // through it WordCraft and DeckCraft at whatever revision Cargo.lock pins — so
    // those join its inputs. Otherwise an engine bump hashes the same as before and
    // the deploy serves the cached wasm it replaced.
    "@build-qube/papyra-office-native#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "**/*.rs",
        "Cargo.toml",
        "package.json",
        "../../crates/papyra-office/src/**",
        "../../crates/papyra-office/Cargo.toml",
        "../../crates/papyra-core/src/**",
        "../../Cargo.lock"
      ],
      "outputs": ["*.node", "index.js", "index.d.ts", "browser.js"]
    },
    "@build-qube/papyra-office-native#build:wasm": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "**/*.rs",
        "Cargo.toml",
        "../../crates/papyra-office/src/**",
        "../../crates/papyra-office/Cargo.toml",
        "../../crates/papyra-core/src/**",
        "../../Cargo.lock"
      ],
      "outputs": [
        "*.wasm",
        "*.cjs",
        "*.cts",
        "*.mjs",
        "browser.js",
        "*.wasi-browser.js"
      ]
    },
    // The same for papyra's own addon, whose crates sit outside its package too: a
    // hayro bump touches only crates/ and Cargo.lock, and would otherwise redeploy
    // the cached wasm it was meant to replace.
    "@build-qube/papyra-native#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "**/*.rs",
        "Cargo.toml",
        "package.json",
        "../../crates/papyra-{core,encode,hayro,tables,tiff}/{src/**,Cargo.toml}",
        "../../Cargo.lock"
      ],
      "outputs": ["*.node", "index.js", "index.d.ts", "browser.js"]
    },
    "@build-qube/papyra-native#build:wasm": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "**/*.rs",
        "Cargo.toml",
        "../../crates/papyra-{core,encode,hayro,tables,tiff}/{src/**,Cargo.toml}",
        "../../Cargo.lock"
      ],
      "outputs": [
        "*.wasm",
        "*.cjs",
        "*.cts",
        "*.mjs",
        "browser.js",
        "*.wasi-browser.js"
      ]
    },
    // TypeDoc cannot run on this repo's TypeScript 7 (its compiler API is gone, and
    // TypeStrong/typedoc#3098 has no timeline), so papyra-docs-gen pins its own
    // TypeScript 5 and emits the API model the /docs route fetches. It reaches both
    // build and typecheck through `^build`, being a devDependency of the demo.
    "papyra-docs-gen#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "typedoc.json",
        "typedoc.registry.json",
        "../papyra/src/**",
        "../pdf-viewer/src/**",
        "../../docs/guides/**"
      ],
      "outputs": [
        "../../apps/demo/public/papyra-api.json",
        "../../apps/demo/public/papyra-registry-api.json"
      ]
    },
    // The registry is built into the demo's `public/`, so it has to exist before
    // vite copies that directory. `PAPYRA_REGISTRY` is declared because it is baked
    // into every item's sibling URLs — turbo strips undeclared env vars, and keying
    // the cache on it stops a localhost build being replayed for a deploy.
    "@workspace/pdf-viewer#build:registry": {
      "env": ["PAPYRA_REGISTRY"],
      "inputs": ["registry.json", "src/**", "scripts/**"],
      "outputs": ["../../apps/demo/public/r/**"]
    },
    "papyra-demo#build": {
      "dependsOn": [
        "^build",
        "@build-qube/papyra-native#build:wasm",
        // The file preview opens Word and PowerPoint through the office addon's
        // wasm, which vite aliases to its gitignored browser glue.
        "@build-qube/papyra-office-native#build:wasm",
        "@workspace/pdf-viewer#build:registry"
      ],
      // PAPYRA_BASE sets vite's base path. Turbo strips env vars a task has not
      // declared, and declaring it also keys the cache on it, so a /Papyra/ build
      // is never served out of a / build's cache entry.
      "env": ["PAPYRA_BASE"],
      // The UI package is consumed as source and has no build task of its own, so
      // turbo would not otherwise hash it — a changed component would be served out
      // of a stale demo bundle.
      "inputs": [
        "src/**",
        "*.html",
        "vite.config.ts",
        "tsconfig.json",
        "components.json",
        "package.json",
        "public/**",
        "../../packages/ui/src/**",
        "../../packages/pdf-viewer/src/**"
      ],
      "outputs": ["dist/**"]
    },
    // Same reason as the build inputs above: the demo's types depend on files turbo
    // cannot see from the default `typecheck` inputs.
    "papyra-demo#typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "*.ts",
        "*.tsx",
        "../../packages/ui/src/**",
        "../../packages/pdf-viewer/src/**"
      ]
    },
    // The demo's units render the docs components from source. The generic `test`
    // task's `dependsOn: build` would build the demo, wasm included, to run them.
    "papyra-demo#test": { "inputs": ["src/**", "test/**"] },
    "dev": { "cache": false, "persistent": true },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "test/**", "__test__/**"]
    },
    // Separate from `test` because these need the compiled addon and the fetched
    // corpus, while `test` is pure TypeScript that CI runs with neither.
    "test:integration": {
      "dependsOn": ["build"],
      "cache": false,
      "inputs": ["src/**", "test/**"]
    },
    "bench": { "dependsOn": ["build"], "cache": false },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "*.ts", "*.tsx"]
    },
    "clean": { "cache": false }
  }
}
