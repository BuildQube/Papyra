{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "**/*.rs", "Cargo.toml", "package.json"],
      "outputs": [
        "dist/**",
        "*.node",
        "*.wasm",
        "index.js",
        "index.d.ts",
        "browser.js",
        "*.cjs",
        "*.mjs"
      ]
    },
    "build:wasm": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "**/*.rs", "Cargo.toml"],
      "outputs": ["*.wasm", "*.cjs", "*.mjs", "browser.js"]
    },
    "dev": { "cache": false, "persistent": true },
    "test": { "dependsOn": ["build"], "inputs": ["src/**", "test/**"] },
    "bench": { "dependsOn": ["build"], "cache": false },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "*.ts", "*.tsx"]
    },
    "clean": { "cache": false }
  }
}
