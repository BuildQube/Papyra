{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "**/*.rs", "Cargo.toml", "package.json"],
      "outputs": [
        "dist/**",
        "*.node",
        "*.wasm",
        "index.js",
        "index.d.ts",
        "browser.js",
        "*.cjs",
        "*.mjs"
      ]
    },
    "build:wasm": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "**/*.rs", "Cargo.toml"],
      "outputs": [
        "*.wasm",
        "*.cjs",
        "*.cts",
        "*.mjs",
        "browser.js",
        "papyra.wasi-browser.js"
      ]
    },
    "papyra-demo#build": {
      "dependsOn": ["^build", "@build-qube/papyra-native#build:wasm"],
      "inputs": [
        "src/**",
        "*.html",
        "vite.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": ["dist/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "test": { "dependsOn": ["build"], "inputs": ["src/**", "test/**"] },
    "bench": { "dependsOn": ["build"], "cache": false },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "*.ts", "*.tsx"]
    },
    "clean": { "cache": false }
  }
}
