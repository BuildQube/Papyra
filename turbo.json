{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "**/*.rs", "Cargo.toml", "package.json"],
      "outputs": [
        "dist/**",
        "*.node",
        "*.wasm",
        "index.js",
        "index.d.ts",
        "browser.js",
        "*.cjs",
        "*.mjs"
      ]
    },
    "build:wasm": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "**/*.rs", "Cargo.toml"],
      "outputs": [
        "*.wasm",
        "*.cjs",
        "*.cts",
        "*.mjs",
        "browser.js",
        "papyra.wasi-browser.js"
      ]
    },
    "papyra-demo#build": {
      "dependsOn": ["^build", "@build-qube/papyra-native#build:wasm"],
      // PAPYRA_BASE sets vite's base path. Turbo strips env vars a task has not
      // declared, and declaring it also keys the cache on it, so a /Papyra/ build
      // is never served out of a / build's cache entry.
      "env": ["PAPYRA_BASE"],
      "inputs": [
        "src/**",
        "*.html",
        "vite.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": ["dist/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "test/**", "__test__/**"]
    },
    // Separate from `test` because these need the compiled addon and the fetched
    // corpus, while `test` is pure TypeScript that CI runs with neither.
    "test:integration": {
      "dependsOn": ["build"],
      "cache": false,
      "inputs": ["src/**", "test/**"]
    },
    "bench": { "dependsOn": ["build"], "cache": false },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "*.ts", "*.tsx"]
    },
    "clean": { "cache": false }
  }
}
