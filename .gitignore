# rust
/target
**/*.rs.bk

# node
node_modules
.turbo
dist
*.tsbuildinfo

# napi build output (generated, never committed)
packages/bindings/*.node
packages/bindings/*.wasm
packages/bindings/index.js
packages/bindings/index.d.ts
packages/bindings/browser.js
packages/bindings/papyra.wasi*.
packages/bindings/papyra.wasi*
packages/bindings/wasi-worker*.mjs
packages/bindings/npm

# third-party test PDFs are fetched, never vendored (mixed provenance)
/corpus
apps/demo/public/*.pdf

# The API model papyra-docs-gen extracts from the wrapper's TSDoc. Generated at
# build time like the napi output above, and stale the moment a comment changes.
apps/demo/public/papyra-api.json

# misc
.DS_Store
*.log

# .claude/skills symlinks into .agents/skills, so the skill content is tracked but
# the resolver's lockfile is not.
skills-lock.json

# Local tooling cache (impeccable design hook)
.impeccable/
