    "priority": "bun run src/priority.ts"
  },
  "dependencies": {
    "@build-qube/papyra": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.7",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "pdfjs-dist": "^6.2.108",
    "typescript": "^5.7.3"
  }
}
