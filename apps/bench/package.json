{
  "name": "papyra-bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "bun run src/render.ts",
    "bench:thumbs": "bun run src/thumbnails.ts",
    "smoke": "bun run src/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
