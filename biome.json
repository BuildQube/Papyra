{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**"]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "attributePosition": "auto",
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "all",
      "test": "all",
      "react": "all"
    },
    "rules": {
      "recommended": true,
      "security": {
        "noGlobalEval": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "noUnusedImports": {
          "level": "error",
          "fix": "safe"
        },
        "useImportExtensions": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui/src/components/**"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["packages/ui/src/components/copy-button.tsx"],
      "linter": {
        "enabled": true
      }
    },
    {
      "includes": [
        "apps/demo/src/components/theme-provider.tsx",
        "packages/pdf-viewer/src/components/pdf-viewer-provider.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/docs-gen/typedoc.registry.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
