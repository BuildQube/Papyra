{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["../papyra/src/index.ts"],
  "tsconfig": "../papyra/tsconfig.json",

  // The package's own README becomes the model's `readme` field — the same comment
  // token stream every doc comment uses, so the /docs route renders the quickstart
  // and the reference through one path, and `{@link}` in it resolves like anywhere
  // else. It is the npm landing page too, so keep it portable: no TSDoc-only syntax.
  "readme": "../papyra/README.md",

  // JSON only — TypeDoc's own HTML theme is never emitted. apps/demo's /docs route
  // renders this model itself so the reference matches the rest of the site.
  //
  // Into public/ rather than src/: it is fetched at runtime, so 144 KB of API model
  // stays out of every bundle, and tsc never has to infer a type for it.
  "json": "../../apps/demo/public/papyra-api.json",
  "pretty": false,

  // Repo-relative source paths, so `sources.fileName` is a link target rather than
  // whatever absolute path the build machine happened to use.
  "basePath": "../..",

  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,

  // The gate. An exported member with no TSDoc fails the build rather than shipping
  // a blank entry in the reference; `bun run typecheck` reaches this via turbo.
  "validation": {
    "notExported": true,
    "notDocumented": true,
    "invalidLink": true
  },
  "treatValidationWarningsAsErrors": true
}
