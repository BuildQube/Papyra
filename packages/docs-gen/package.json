{
  "name": "papyra-docs-gen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Extracts the @build-qube/papyra API model from its TSDoc comments",
  "scripts": {
    "build": "typedoc && typedoc --options typedoc.registry.json && typedoc --entryPoints ../papyra/src/index.ts --entryPoints ../papyra/src/office.ts --emit none",
    "clean": "rm -rf ../../apps/demo/src/generated .turbo"
  },
  "devDependencies": {
    "@build-qube/papyra": "workspace:*",
    "@workspace/pdf-viewer": "workspace:*",
    "typedoc": "^0.28.20",
    "typescript": "5.9.3"
  }
}
