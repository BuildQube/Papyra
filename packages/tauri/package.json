{
  "name": "@build-qube/papyra-tauri",
  "version": "0.6.0",
  "description": "A Tauri engine for papyra's viewer: PDFs parsed and rendered in the app's host process by tauri-plugin-papyra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildQube/papyra.git",
    "directory": "packages/tauri"
  },
  "keywords": [
    "pdf",
    "tauri",
    "papyra",
    "viewer",
    "mobile"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test:integration": "bun test test/integration"
  },
  "peerDependencies": {
    "@build-qube/papyra": "^0.6.0",
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@build-qube/papyra": "0.6.0",
    "@tauri-apps/api": "^2.9.0",
    "typescript": "^7.0.2"
  }
}
