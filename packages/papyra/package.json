{
  "name": "@build-qube/papyra",
  "version": "0.4.0",
  "description": "Fast PDF rendering for Node and the browser, powered by Rust",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildQube/papyra.git",
    "directory": "packages/papyra"
  },
  "keywords": [
    "pdf",
    "render",
    "thumbnail",
    "rust",
    "wasm",
    "pdfjs"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./engine": {
      "types": "./dist/papyra-engine.d.ts",
      "default": "./dist/papyra-engine.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration"
  },
  "dependencies": {
    "@build-qube/papyra-native": "0.4.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
